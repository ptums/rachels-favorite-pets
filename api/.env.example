# Copy to api/.env (git-ignored). These values run against the local emulators
# from docker-compose.yml. The AWS keys are dummies; the emulators accept any value.
PORT=5017

# owner | open | accounts
AUTH_MODE=open

# Signs the session cookie. Any long random string; change it for anything but local use.
SESSION_SECRET=local-dev-only-change-me

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_PHOTOS_TABLE=photos
DYNAMODB_USERS_TABLE=users

S3_ENDPOINT=http://localhost:9090
S3_BUCKET=photos

# Required in owner mode, optional in open mode. Hash from: npm run hash -- <password>
OWNER_USERNAME=
OWNER_PASSWORD_HASH=
